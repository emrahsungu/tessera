<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A project set up the wrong way on purpose: it references src/Tessera without the source generator. scripts/test.ps1
    builds it, expecting warning TESSERA015 (Directory.Build.targets), and runs it, expecting Serialize to explain how to
    add the generator. Not in Tessera.slnx, so the warning does not show up in ordinary builds.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>false</MSBuildTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tessera\Tessera.csproj" />
  </ItemGroup>

</Project>
