<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <NoWarn>$(NoWarn);CS1591;CA1707;CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- A second model assembly whose types the models here use (cross-assembly C++ headers and defaults). -->
    <ProjectReference Include="..\Tessera.Tests.Shared\Tessera.Tests.Shared.csproj" />
  </ItemGroup>

  <Import Project="..\..\src\Tessera.ProjectReference.targets" />

</Project>
