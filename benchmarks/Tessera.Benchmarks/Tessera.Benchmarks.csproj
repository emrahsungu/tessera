<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CS8632;CS8618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8625</NoWarn>
    <IsPackable>false</IsPackable>
    <TesseraCppHeaderName>bench.tessera.hpp</TesseraCppHeaderName>
    <TesseraCppOutputDir>..\generated\tessera</TesseraCppOutputDir>
    <!-- The native benchmark compiles against cpp/include directly. -->
    <TesseraCppCopyRuntime>false</TesseraCppCopyRuntime>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="MessagePack" Version="3.1.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlatBuffers.Runtime\FlatBuffers.Runtime.csproj" />
  </ItemGroup>

  <!-- C# code generated by flatc from benchmarks/schemas/bench.fbs and by protoc from benchmarks/schemas/bench.proto
       (scripts/bench.ps1 runs both). -->
  <ItemGroup>
    <Compile Include="..\generated\fb-csharp\**\*.cs" LinkBase="FbGenerated" />
    <Compile Include="..\generated\pb-csharp\**\*.cs" LinkBase="PbGenerated" />
  </ItemGroup>

  <Import Project="..\..\src\Tessera.ProjectReference.targets" />

</Project>
