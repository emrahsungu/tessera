<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CS8632;CS8618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8625</NoWarn>
    <IsPackable>false</IsPackable>
    <TesseraCppHeaderName>bench.tessera.hpp</TesseraCppHeaderName>
    <TesseraCppOutputDir>..\generated\tessera</TesseraCppOutputDir>
    <!-- The native benchmark compiles against cpp/include directly. -->
    <TesseraCppCopyRuntime>false</TesseraCppCopyRuntime>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.10" />
  </ItemGroup>

  <!-- Result arrays of every library (up to about 1 MB, on the canada workload) are allocated as ordinary objects that
       die young. With the default threshold (85 KB) they are large objects, which only the much rarer full
       collections free, and the time those take per write varied erratically with the exact size (155 KB cost twice
       as much as 240 KB, for example), so equal work by two libraries could time differently. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.LOHThreshold" Value="4194304" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlatBuffers.Runtime\FlatBuffers.Runtime.csproj" />
  </ItemGroup>

  <!-- C# code generated by flatc from benchmarks/schemas/bench.fbs (scripts/bench.ps1 runs flatc). -->
  <ItemGroup>
    <Compile Include="..\generated\fb-csharp\**\*.cs" LinkBase="FbGenerated" />
  </ItemGroup>

  <Import Project="..\..\src\Tessera.ProjectReference.targets" />

</Project>
